# Everything is optional. With nothing set, VoysNote runs in demo mode:
# seeded content, local-only state, simulated checkout.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (VoysNote+ subscription and paid series)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
